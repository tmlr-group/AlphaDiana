FROM rust:1-slim-bookworm AS zeroclaw-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install zeroclawlabs@0.6.9 --locked

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl docker.io file git gnupg libssl3 python3 python3-pip sqlite3 xxd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=zeroclaw-builder /usr/local/cargo/bin/zeroclaw /usr/local/bin/zeroclaw

WORKDIR /workspace

RUN zeroclaw --version

CMD ["bash"]
