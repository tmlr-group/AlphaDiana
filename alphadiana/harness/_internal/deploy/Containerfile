FROM docker.io/library/node@sha256:4bd6219054c8bebcd26a66bfd8ca0bd6e1024b4b97474c59bb7ee3bbcbef4fe8
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /opt/requirements.txt
RUN python3 -m venv /opt/runtime && /opt/runtime/bin/pip install --require-hashes -r /opt/requirements.txt
COPY package.json package-lock.json /opt/pi/
RUN cd /opt/pi && npm ci --ignore-scripts --omit=dev --no-audit --no-fund
COPY bridge.py /opt/bridge.py
ENV PATH="/opt/runtime/bin:/usr/local/bin:/usr/bin:/bin" HOME="/tmp/home"
WORKDIR /work
# Some rootless Podman versions copy the image mode onto the task tmpfs.
RUN chmod 1777 /work
USER 1000:1000
CMD ["/opt/runtime/bin/python", "/opt/bridge.py"]
