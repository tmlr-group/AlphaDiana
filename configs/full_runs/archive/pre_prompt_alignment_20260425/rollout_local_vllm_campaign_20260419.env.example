# Copy this file to a local rollout env file, edit the placeholders, then:
#   set -a
#   source /path/to/this-file
#   set +a

# AlphaDiana root
export PYTHONPATH="$PWD"

# Local vLLM endpoints
export QWEN_VLLM_API_BASE="http://127.0.0.1:8001/v1"
export QWEN_VLLM_API_KEY="EMPTY"

export GEMMA4_VLLM_API_BASE="http://127.0.0.1:8002/v1"
export GEMMA4_VLLM_API_KEY="EMPTY"

export NEMOTRON_VLLM_API_BASE="http://127.0.0.1:8003/v1"
export NEMOTRON_VLLM_API_KEY="EMPTY"

# Optional legacy defaults used by some existing configs or ad-hoc probes
export OPENAI_BASE_URL="$QWEN_VLLM_API_BASE"
export OPENAI_API_KEY="$QWEN_VLLM_API_KEY"
export OPENAI_MODEL_NAME="Qwen/Qwen3.5-27B"

# HLE / datasets
export HF_TOKEN="hf_..."
export HF_ENDPOINT="https://hf-mirror.com"

# terminal-bench-2 task checkout
export TERMINAL_BENCH2_DIR="/abs/path/to/terminal-bench/tasks"

# Official direct-LLM checkout root
export DIRECTLLM_ROOT="/abs/path/to/directllm"
export DIRECTLLM_TB2_ROOT="${DIRECTLLM_ROOT}/terminal-bench-2"
export DIRECTLLM_SWEBENCH_ROOT="${DIRECTLLM_ROOT}/SWE-bench_Pro-os"

# SWE-bench Pro official evaluator assets
export SWE_BENCH_PRO_EVAL_SCRIPT="${DIRECTLLM_SWEBENCH_ROOT}/swe_bench_pro_eval.py"
export SWE_BENCH_PRO_SCRIPTS_DIR="${DIRECTLLM_SWEBENCH_ROOT}/run_scripts"

# Optional runtime image overrides
# Use this when Docker Hub does not provide tmlrgroup/alphadiana:opencode.
# export SWEBENCH_OPENCODE_RUNTIME_IMAGE="external_benchmark/opencode:latest"

# Use this when the default ZeroClaw runtime source image is not available.
# export SWEBENCH_ZEROCLAW_RUNTIME_IMAGE="zeroclaw-reasoning:0.6.9"

# Optional temp directories for container-heavy benchmarks
# export TMPDIR="/path/to/$USER/tmp/alphadiana"
# export HF_HOME="/path/to/$USER/cache/hf"
# export HF_DATASETS_CACHE="/path/to/$USER/cache/hf/datasets"
