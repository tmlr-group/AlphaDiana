# MoltBench GPU Base Image
# Contains: CUDA 12.8 + Python 3.11 + PyTorch + Triton + AutoKernel + KernelBench datasets
#
# Build (from AlphaDiana repo root, requires network for git clone):
#   docker build --network host -f moltbench/docker/Dockerfile.base -t tmlrgroup/alphadiana:gpu-base .
#
# AutoKernel is cloned at build time (not vendored). Pin the commit in
# seeds.yaml and here to ensure reproducibility.

FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip \
        curl git ca-certificates && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Clone AutoKernel at pinned commit (see moltbench/seeds.yaml)
ARG AUTOKERNEL_REPO=https://github.com/RightNow-AI/autokernel.git
ARG AUTOKERNEL_COMMIT=7843582
RUN git clone "$AUTOKERNEL_REPO" /workspace/autokernel && \
    cd /workspace/autokernel && \
    git checkout "$AUTOKERNEL_COMMIT"
WORKDIR /workspace/autokernel

# Install PyTorch with CUDA 12.8 and other dependencies via pip
RUN python3 -m pip install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cu128 && \
    python3 -m pip install --no-cache-dir \
        triton>=3.3.0 matplotlib numpy pandas datasets ninja

# Verify torch + CUDA
RUN python3 -c "import torch; print(f'PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"

# NOTE: KernelBench datasets are fetched at runtime (build-time fetch
# fails behind proxies). To pre-bake, run the container once with network
# access and commit the image.

# Artifacts output directory
RUN mkdir -p /workspace/artifacts

# Copy entrypoint
COPY moltbench/docker/run_task.sh /workspace/run_task.sh
RUN chmod +x /workspace/run_task.sh

ENTRYPOINT ["/workspace/run_task.sh"]
