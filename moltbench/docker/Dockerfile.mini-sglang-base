# MoltBench mini-SGLang Base Image
#
# Contains: CUDA + PyTorch + flashinfer + mini-sglang source (editable install)
#
# Build (from AlphaDiana repo root):
#   docker build --network host \
#     -f moltbench/docker/Dockerfile.mini-sglang-base \
#     -t tmlrgroup/alphadiana:mini-sglang-base .
#
# Build context: expects mini-sglang source to be cloned at build time.
# The base image (jinbo/mini-sglang:clean) already has CUDA + PyTorch +
# flashinfer + all Python dependencies pre-installed.

FROM jinbo/mini-sglang:clean

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# The conda env (torch + flashinfer + deps) lives in the FROM base image. Its real
# path there is machine-specific, so we expose it under a STABLE, generic mount point
# /opt/minisgl-env via a symlink — all eval code references /opt/minisgl-env only.
# Building on a different base? Override the real path: --build-arg MINISGL_ENV=<path>.
ARG MINISGL_ENV=/data3/jinbo/envs/mini_sglang
RUN ln -sfn "$MINISGL_ENV" /opt/minisgl-env
ENV PATH="/opt/minisgl-env/bin:${PATH}"
ENV PYBIN="/opt/minisgl-env/bin/python"

# Install debugging tools the agent may need
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      lsof psmisc iproute2 procps \
    && rm -rf /var/lib/apt/lists/*

# Clone mini-sglang source (agent will edit these files)
# Use a commit BEFORE mini-sglang#97 (Better Estimation Policy) was merged,
# so the agent has room to implement that optimization.
# Commit 20fcd7f is the last commit before PR#97 changes (which exist as
# uncommitted local modifications in the repo). This is the clean baseline.
# Override at build time: --build-arg MINISGLANG_COMMIT=<hash>
ARG MINISGLANG_REPO=https://github.com/sgl-project/mini-sglang.git
ARG MINISGLANG_COMMIT=20fcd7f
RUN git clone "$MINISGLANG_REPO" /workspace/repo && \
    cd /workspace/repo && \
    git checkout "$MINISGLANG_COMMIT"

# Install mini-sglang in editable mode (source changes take effect on restart)
RUN pip install msgpack accelerate httpx --quiet && \
    pip install -e /workspace/repo/ --quiet --no-deps

# Initialize git for change tracking
RUN git -C /workspace/repo config user.email "moltbench@eval" && \
    git -C /workspace/repo config user.name "MoltBench" && \
    git -C /workspace/repo add -A && \
    git -C /workspace/repo commit -m "baseline source" --quiet

# Copy eval scripts (hidden from agent's workspace)
COPY moltbench/docker/mini_sglang/run_eval.sh        /eval/run_eval
COPY moltbench/docker/mini_sglang/eval_runner.py     /eval/eval_runner.py
COPY moltbench/docker/mini_sglang/bench_serving.py   /eval/bench_serving.py
COPY moltbench/docker/mini_sglang/call_gateway.py    /eval/call_gateway.py
COPY moltbench/docker/mini_sglang/collect_artifacts.py /eval/collect_artifacts.py
COPY moltbench/docker/mini_sglang/openclaw_minisgl.json.template /eval/openclaw_minisgl.json.template
COPY moltbench/docker/mini_sglang/run_minisgl.sh     /workspace/run_minisgl.sh
RUN chmod +x /eval/run_eval /workspace/run_minisgl.sh && mkdir -p /eval/state

# Environment defaults for the mini-sglang server. MODEL_PATH is NOT baked (it is
# machine-specific) — supply it at run time via -e MODEL_PATH=<path>, or a friendly
# -e MODEL=qwen3-4b alias resolved under -e MODELS_HUB=<HF cache hub dir>.
# MODELS_HUB defaults to the conventional shared HF cache mount; override as needed.
ENV MODELS_HUB=/data0/models/hub
ENV MINISGL_PORT=31000
ENV EVAL_NUM_PROMPTS=64
ENV EVAL_INPUT_LEN=128
ENV EVAL_OUTPUT_LEN=128

# Artifact and task directories
RUN mkdir -p /workspace/artifacts /workspace/task

# Copy shared MoltBench entrypoint
COPY moltbench/docker/run_task.sh /workspace/run_task.sh
RUN chmod +x /workspace/run_task.sh

WORKDIR /workspace
ENTRYPOINT ["/workspace/run_task.sh"]
