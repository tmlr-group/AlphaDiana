# MoltBench + OpenCode (Direct CLI Mode)
#
# OpenCode runs as a CLI agent (like Claude Code), directly executing
# in the workspace without a gateway server.
#
# Build (from AlphaDiana repo root):
#   # Docker:
#   docker build -f moltbench/docker/Dockerfile.opencode -t tmlrgroup/alphadiana:opencode .
#   # Podman:
#   podman build -f moltbench/docker/Containerfile.opencode -t tmlrgroup/alphadiana:opencode .
#
# Uses the same run_task.sh entrypoint; MOLTBENCH_AGENT=opencode selects
# the launch_opencode() path.

FROM tmlrgroup/alphadiana:gpu-base

# Node.js runtime (required by OpenCode)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install OpenCode
RUN npm install -g opencode-ai@1.3.2

# uv package manager (AutoKernel references `uv run` everywhere)
RUN python3 -m pip install --no-cache-dir uv

# Git config (required for kernel.py versioning)
RUN git config --global user.email "moltbench@eval" && \
    git config --global user.name "MoltBench"

# Copy OpenCode config template
COPY moltbench/docker/opencode.json.template /workspace/opencode.json.template

# Task runner (shared with OpenClaw)
COPY moltbench/docker/run_task.sh /workspace/run_task.sh
RUN chmod +x /workspace/run_task.sh

# Verify opencode is available
RUN opencode --version
