# QJL + Claude Code. Evaluation remains in the external verifier image.
ARG QJL_BASE_IMAGE=localhost/alphadiana:qjl-base
FROM ${QJL_BASE_IMAGE}

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

ARG CLAUDE_CODE_VERSION=2.1.52
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

RUN git config --global user.email "moltbench@eval" && \
    git config --global user.name "MoltBench"

COPY moltbench/docker/run_task.sh /workspace/run_task.sh
RUN chmod +x /workspace/run_task.sh && claude --version
