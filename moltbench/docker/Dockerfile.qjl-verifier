# Host-controlled QJL verifier. This image is never used as an agent image.
ARG QJL_BASE_IMAGE=localhost/alphadiana:qjl-base
FROM ${QJL_BASE_IMAGE}

RUN rm -rf /opt/qjl-seed && \
    cp -r /workspace/repo /opt/qjl-seed && \
    chmod -R a-w /opt/qjl-seed && \
    mkdir -p /verifier /artifacts

COPY moltbench/seeds/qjl/bench_cuda.py /verifier/bench_cuda.py
COPY moltbench/verifier/qjl/core.py /verifier/core.py
COPY moltbench/verifier/qjl/service.py /verifier/service.py
COPY moltbench/verifier/qjl/official_eval.py /verifier/official_eval.py
COPY moltbench/verifier/qjl/seed_candidate.json /verifier/seed_candidate.json

ENV QJL_SEED_ROOT=/opt/qjl-seed
ENV QJL_SANDBOX_USER=nobody
EXPOSE 8081
ENTRYPOINT ["python3", "/verifier/service.py"]
