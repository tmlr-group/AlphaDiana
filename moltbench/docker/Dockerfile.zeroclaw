# MoltBench + ZeroClaw (CLI Mode)
#
# ZeroClaw is a Rust-based lightweight AI assistant infrastructure.
# This container runs ZeroClaw in single-shot agent CLI mode.
#
# Build (from AlphaDiana repo root):
#   # Docker:
#   docker build -f moltbench/docker/Dockerfile.zeroclaw -t tmlrgroup/alphadiana:zeroclaw .
#   # Podman:
#   podman build -f moltbench/docker/Containerfile.zeroclaw -t tmlrgroup/alphadiana:zeroclaw .
#
# The container runs ZeroClaw in agent CLI mode:
#   1. Configures ZeroClaw with an OpenAI-compatible provider via ~/.zeroclaw/config.toml
#   2. Runs `zeroclaw agent -m "task"` to solve the optimization problem
#   3. ZeroClaw uses its agentic loop (tool calls: shell, file I/O, git) autonomously
#
# Reference: https://github.com/zeroclaw-labs/zeroclaw

# ─── Stage 1: Build ZeroClaw binary ───
FROM rust:1-slim-bookworm AS zc-builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install ZeroClaw from crates.io
RUN cargo install zeroclawlabs@0.6.9 --locked

# ─── Stage 2: MoltBench GPU base + ZeroClaw ───
FROM tmlrgroup/alphadiana:gpu-base

# Copy ZeroClaw binary from build stage
COPY --from=zc-builder /usr/local/cargo/bin/zeroclaw /usr/local/bin/zeroclaw

# Install OpenSSL runtime (required by ZeroClaw for HTTPS)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv package manager (AutoKernel references `uv run` everywhere)
RUN python3 -m pip install --no-cache-dir uv

# Git config (required for kernel.py versioning)
RUN git config --global user.email "moltbench@eval" && \
    git config --global user.name "MoltBench"

# Keep run_task.sh in the leaf image so ZeroClaw builds don't depend on
# rebuilding gpu-base just to pick up entrypoint/script changes.
COPY moltbench/docker/run_task.sh /workspace/run_task.sh
RUN chmod +x /workspace/run_task.sh

# Verify zeroclaw is available
RUN zeroclaw --version
